# Copy to .env.local. All values are placeholders. Never commit real keys.

# Optional. Without it every check is deterministic and AI rewrite drafts / AI rule proposals are off.
ANTHROPIC_API_KEY=
# Optional. Google AI Studio key for the Gemini provider (free tier available).
GEMINI_API_KEY=
# Optional model override for Gemini (default: gemini-3.5-flash-lite)
GEMINI_MODEL=
# Optional: "anthropic" or "gemini". Default: Anthropic if its key is set, else Gemini.
LLM_PROVIDER=
# Optional model override (default: claude-sonnet-5-5)
ANTHROPIC_MODEL=
# Optional LLM timeout in ms (default 20000)
LLM_TIMEOUT_MS=

# PostgreSQL (Supabase). REQUIRED on Vercel. Use the POOLED connection string (transaction pooler, port 6543).
DATABASE_URL=
# Direct (non-pooled) connection string, used only by `npm run db:migrate`.
DATABASE_URL_DIRECT=
# Optional: max connections per serverless instance (default 3).
DB_POOL_MAX=
# Optional: apply migrations on first connect instead of via `npm run db:migrate` (default off).
DB_AUTO_MIGRATE=
# Local dev / tests only, used when DATABASE_URL is unset: embedded Postgres (PGlite) directory
# (default .data/pglite; ":memory:" for throwaway). Ignored when DATABASE_URL is set; refused on Vercel.
DATABASE_PATH=

# LLM kill switch: set to 1 to force deterministic-only checks even if keys are set.
LLM_DISABLED=
# Hard ceiling in ms for one LLM operation including retries (default 25000).
LLM_DEADLINE_MS=

# Demo role switching is NOT authentication. Default: on outside production, OFF in production (every visitor is a Creator).
# Set to 1 only on a deliberate public demo where anyone may act as any role.
DEMO_ROLE_SWITCH=
# Destructive "Reset demo data" is OFF unless this is 1.
DEMO_RESET_ENABLED=
